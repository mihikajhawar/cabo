// Prisma schema — identity and completed-round history only.
// Live, in-memory GameState (deck order, hands, knowledge, turn/contest state)
// never touches this database. See architecture §M.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameStatus {
  LOBBY
  IN_PROGRESS
  COMPLETE
}

model Game {
  id        String     @id @default(cuid())
  code      String     @unique
  hostId    String
  status    GameStatus @default(LOBBY)
  createdAt DateTime   @default(now())

  players Player[]
  rounds  Round[]
}

model Player {
  id           String  @id @default(cuid())
  gameId       String
  displayName  String
  sessionToken String  @unique

  game Game @relation(fields: [gameId], references: [id])

  @@index([gameId])
}

model Round {
  id          String    @id @default(cuid())
  gameId      String
  roundNumber Int
  startedAt   DateTime  @default(now())
  endedAt     DateTime?

  game   Game         @relation(fields: [gameId], references: [id])
  result RoundResult?

  @@unique([gameId, roundNumber])
}

model RoundResult {
  id                String  @id @default(cuid())
  roundId           String  @unique
  perPlayerScoreJson Json
  caboCallerId      String?
  caboSucceeded     Boolean
  winnerIdsJson     Json

  round Round @relation(fields: [roundId], references: [id])
}
